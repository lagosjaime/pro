# Identidad del usuario del host (evita archivos de root en vendor/)
UID=1000
GID=1000

# Puertos en el host
HTTP_PORT=8080
MYSQL_PORT=3306
PHPMYADMIN_PORT=8081

# Aplicación
APP_NAME=pr
APP_ENV=local
APP_DEBUG=true

# MySQL
MYSQL_ROOT_PASSWORD=cambia-esta-clave
MYSQL_DATABASE=pr_db
MYSQL_USER=pr
MYSQL_PASSWORD=cambia-esta-clave

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=cambia-esta-clave
REDIS_DB=0

# URLs de WServices
APP_URL=http://localhost:8080
WSE_MODE=local
WSE_URL=http://localhost:8080
WSE_PUBLIC_URL=http://localhost:8080
# Solo para modo proxy:
# WSE_INTERNAL_URL=http://wservices-interno:9090
# WSE_AUTH_HEADER=X-WSE-Token
# WSE_AUTH_TOKEN=change-me
WSE_TIMEOUT=30
